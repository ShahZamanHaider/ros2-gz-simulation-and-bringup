<?xml version="1.0"?>
<robot name="my_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="PI" value="3.1415926535897931"/>

  <xacro:property name="base_len" value="0.6" />
  <xacro:property name="base_width" value="0.4" />
  <xacro:property name="base_height" value="0.2" />
  <xacro:property name="base_mass" value="10.0" />

  <xacro:property name="cabin_len" value="0.3" />
  <xacro:property name="cabin_width" value="0.35" />
  <xacro:property name="cabin_height" value="0.15" />
  <xacro:property name="cabin_mass" value="5.0" />

  <xacro:property name="wheel_radius" value="0.1" />
  <xacro:property name="wheel_length" value="0.05" />
  <xacro:property name="wheel_mass" value="1.0" />

  <xacro:property name="camera_length" value="0.01" />
  <xacro:property name="camera_width" value="0.1" />
  <xacro:property name="camera_height" value="0.05" />

  <xacro:property name="wheel_x_offset" value="0.2" /> <xacro:property name="wheel_y_offset" value="${base_width/2 + wheel_length/2}" /> <xacro:property name="wheel_z_offset" value="0.0" /> <xacro:macro name="box_inertial" params="m x y z">
    <inertial>
      <mass value="${m}" />
      <inertia ixx="${(m/12.0) * (y*y + z*z)}" ixy="0.0" ixz="0.0"
               iyy="${(m/12.0) * (x*x + z*z)}" iyz="0.0"
               izz="${(m/12.0) * (x*x + y*y)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertial" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="${(m/12.0) * (3*r*r + h*h)}" ixy="0.0" ixz="0.0"
               iyy="${(m/2.0) * (r*r)}" iyz="0.0"
               izz="${(m/12.0) * (3*r*r + h*h)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="wheel" params="prefix parent *origin">
    <link name="wheel_${prefix}">
      <visual>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
        </geometry>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <material name="black"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
        </geometry>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <surface>
            <friction>
                <ode>
                    <mu>0.9</mu>
                    <mu2>0.9</mu2>
                </ode>
            </friction>
        </surface>
      </collision>
      <xacro:cylinder_inertial m="${wheel_mass}" r="${wheel_radius}" h="${wheel_length}"/>
    </link>
    <joint name="wheel_${prefix}_joint" type="continuous">
      <parent link="${parent}"/>
      <child link="wheel_${prefix}"/>
      <xacro:insert_block name="origin"/>
      <axis xyz="0 1 0"/>
    </joint>
    <gazebo reference="wheel_${prefix}">
        <material>Gazebo/Black</material>
    </gazebo>
  </xacro:macro>

  <material name="blue">
    <color rgba="0.2 0.4 0.8 1.0" />
  </material>

  <material name="black">
    <color rgba="0.0 0.0 0.0 1.0" />
  </material>

  <material name="window_black">
    <color rgba="0.1 0.1 0.1 0.7" />
  </material>

  <material name="Grey">
    <color rgba="0.5 0.5 0.5 1.0" />
  </material>

  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="${base_len} ${base_width} ${base_height}" />
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <box size="${base_len} ${base_width} ${base_height}" />
      </geometry>
    </collision>
    <xacro:box_inertial m="${base_mass}" x="${base_len}" y="${base_width}" z="${base_height}" />
  </link>
  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>

  <link name="cabin_link">
      <visual>
          <geometry>
              <box size="${cabin_len} ${cabin_width} ${cabin_height}" />
          </geometry>
          <material name="window_black"/>
      </visual>
      <collision>
          <geometry>
              <box size="${cabin_len} ${cabin_width} ${cabin_height}" />
          </geometry>
      </collision>
      <xacro:box_inertial m="${cabin_mass}" x="${cabin_len}" y="${cabin_width}" z="${cabin_height}" />
  </link>
  <gazebo reference="cabin_link">
      <material>Gazebo/DarkGrey</material>
      <transparent>true</transparent>
  </gazebo>

<link name = "camera_link">

<visual>
<geometry>
<box size = "${camera_length} ${camera_width} ${camera_height}"/>
</geometry>
  <material name="Grey" />
</visual>

<collision>
<geometry>
    <box size= "${camera_length} ${camera_width} ${camera_height}" />
</geometry>
</collision>
<xacro:box_inertial m="0.5" x="${camera_length}" y="${camera_width}" z="${camera_height}" />
</link>


<link name="camera_link_optical" />

    <joint name="camera_optical_joint" type="fixed">
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
        <parent link="camera_link"/>
        <child link="camera_link_optical"/>
    </joint>
    

    <gazebo reference="camera_link">
        <sensor name="camera" type="camera">
            <camera>
                <horizontal_fov>1.3962634</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.1</near>
                    <far>15</far>
                </clip>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.007</stddev>
                </noise>
                <optical_frame_id>camera_link_optical</optical_frame_id>
                <camera_info_topic>camera/camera_info</camera_info_topic>
            </camera>
            <always_on>1</always_on>
            <update_rate>20</update_rate>
            <visualize>true</visualize>
            <topic>camera/image_raw</topic>            
        </sensor>
    </gazebo>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0" />
  </joint>

  <joint name="cabin_joint" type="fixed">
      <parent link="base_link" />
      <child link="cabin_link" />
      <origin xyz="${0.05} 0 ${base_height/2 + cabin_height/2}" rpy="0 0 0" />
  </joint>


  <joint name ="base_camera_joint" type = "fixed">
  <parent link="base_link"/>
  <child link="camera_link"/>
  <origin xyz = "0.31 0 0" rpy = "0 0 0"/>
  </joint>
  

  <xacro:wheel prefix="front_left" parent="base_link">
    <origin xyz="${wheel_x_offset} ${wheel_y_offset} ${wheel_z_offset}" rpy="0 0 0" />
  </xacro:wheel>
  <xacro:wheel prefix="front_right" parent="base_link">
    <origin xyz="${wheel_x_offset} -${wheel_y_offset} ${wheel_z_offset}" rpy="0 0 0" />
  </xacro:wheel>
  <xacro:wheel prefix="back_left" parent="base_link">
    <origin xyz="-${wheel_x_offset} ${wheel_y_offset} ${wheel_z_offset}" rpy="0 0 0" />
  </xacro:wheel>
  <xacro:wheel prefix="back_right" parent="base_link">
    <origin xyz="-${wheel_x_offset} -${wheel_y_offset} ${wheel_z_offset}" rpy="0 0 0" />
  </xacro:wheel>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_front_left_joint</left_joint>
      <left_joint>wheel_back_left_joint</left_joint>
      <right_joint>wheel_front_right_joint</right_joint>
      <right_joint>wheel_back_right_joint</right_joint>
      <wheel_separation>${2*wheel_y_offset}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <odom_topic>odom</odom_topic>
      <topic>/model/my_robot/cmd_vel</topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <update_rate>50</update_rate>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>wheel_back_left_joint</joint_name>
      <joint_name>wheel_back_right_joint</joint_name>
      <joint_name>wheel_front_left_joint</joint_name>
      <joint_name>wheel_front_right_joint</joint_name>
    </plugin>
  </gazebo>

</robot>